# ==============================================================================
# PRAVAAH — Production Environment Configuration for EC2
# Domain: https://pravaah.ashuttosh.me/
# ==============================================================================

# Database (PostgreSQL + PostGIS container)
POSTGRES_DB=pravaah
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql://postgres:replace_with_a_strong_password@postgres:5432/pravaah?sslmode=disable

# Redis (container)
REDIS_URL=redis://redis:6379

# Machine Learning Service (container)
ML_SERVICE_URL=http://ml-service:8000

# Authentication & Security
PORT=4000
JWT_SECRET=replace_with_a_random_secure_jwt_secret

# Frontend Public URLs (baked into client build)
NEXT_PUBLIC_BACKEND_URL=https://pravaah.ashuttosh.me
NEXT_PUBLIC_SOCKET_URL=https://pravaah.ashuttosh.me

# Twilio Alert Dispatch (Optional for SMS / WhatsApp evacuation alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
